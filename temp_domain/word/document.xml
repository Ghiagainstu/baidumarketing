6/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid wp14">
  <w:body>
    <w:p w14:paraId="3100036A" w14:textId="67F504C7" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:pPr>
        <w:pStyle w:val="1"/>
        <w:rPr>
          <w:rFonts w:hint="eastAsia"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="eastAsia"/>
        </w:rPr>
        <w:t>C</w:t>
      </w:r>
      <w:r>
        <w:t>an I use a different domain for my Baidu PPC account?</w:t>
      </w:r>
      
    </w:p>
    <w:p w14:paraId="688FC99B" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4"/>
    <w:p w14:paraId="6F361FD0" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:r>
        <w:t xml:space="preserve">Yes, you can. </w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="0A6F6CF8" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4"/>
    <w:p w14:paraId="6FB42A0D" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:r>
        <w:t>Normally speaking, Baidu only allows one promotion URL for one Baidu account. However, below circumstances are allowed.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="6DBE2B42" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4"/>
    <w:p w14:paraId="338E6A9A" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:r>
        <w:t xml:space="preserve">There are 3 kinds of way to use a different domain. </w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="799C77E0" w14:textId="79C56A54" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:r>
        <w:t xml:space="preserve">One is to add a tracking URL for you account. Baidu does allow to use a tracking URLs. Before you apply this, you are not able to use any tracking URLs. This is why a lot of users who use Adobe, Google 360, kenshoo, Marin and so on to manage their Baidu account can&#x2019;t sync their account. Because these tracking tools use a tracking UTLs. So, before you do the sync, one tracking URL than can redirects to you own domain is needed. For example, if you domain is a.com and you tracking domain is b.com. You will need a tracking URL that is something like b.com/xxxxx and this URL can redirect to a.com after you open b.com/xxxxx as your register domain is a.com. You cannot redirect to domains other than a.com because it will violate Baidu policy. </w:t>
      </w:r>
      
      
      
      
    </w:p>
    <w:p w14:paraId="7B8073F7" w14:textId="09EDCEFC" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4"/>
    <w:p w14:paraId="5716CC3B" w14:textId="2EBE5143" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:r>
        <w:t xml:space="preserve">Here is an Adobe Tracking URL </w:t>
      </w:r>
      
      <w:bookmarkStart w:id="0" w:name="_GoBack"/>
      <w:bookmarkEnd w:id="0"/>
      <w:r>
        <w:t>example:</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="032A3D97" w14:textId="36E700CF" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:pPr>
        <w:rPr>
          <w:rFonts w:hint="eastAsia"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:t>http://pixel.everesttech.net/5232/cq?ev_sid=88&amp;ev_lx={keywordid}&amp;ev_crx={creative}&amp;ev_pl={placement}&amp;url=https%3A//www.baidu.com/</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="794AC3E6" w14:textId="258D126D" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:r>
        <w:t>The domain is everesttech.net, however it redirects to Baidu.com</w:t>
      </w:r>
      
      
    </w:p>
    <w:p w14:paraId="3008A775" w14:textId="570CEE65" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4"/>
    <w:p w14:paraId="2622900E" w14:textId="6BA00754" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="eastAsia"/>
        </w:rPr>
        <w:t>A</w:t>
      </w:r>
      <w:r>
        <w:t>nd an example of Google 360 Tracking URL:</w:t>
      </w:r>
      
      
    </w:p>
    <w:p w14:paraId="1F671D90" w14:textId="153B0465" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:hyperlink r:id="rId6" w:history="1">
        <w:r>
          <w:rPr>
            <w:rStyle w:val="a7"/>
          </w:rPr>
          <w:t>http://clickserve.dartsearch.net/link/click?lid=437000520415462&amp;ds_s_kwgid=587000057089100&amp;ds_e_adid={creative}&amp;ds_e_device=c&amp;ds_url_v=2&amp;ds_dest_url=https://www.baidu.com/</w:t>
        </w:r>
      </w:hyperlink>
    </w:p>
    <w:p w14:paraId="022DB125" w14:textId="142445F9" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4"/>
    <w:p w14:paraId="4E9D2C89" w14:textId="0E1F185D" w:rsidR="007930C4" w:rsidRPr="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:pPr>
        <w:rPr>
          <w:rFonts w:hint="eastAsia"/>
        </w:rPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="eastAsia"/>
        </w:rPr>
        <w:t>t</w:t>
      </w:r>
      <w:r>
        <w:t>he domain is dartsearch.net and it redirects to Baidu.com</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="6FDC2FBE" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:pPr>
        <w:rPr>
          <w:rFonts w:hint="eastAsia"/>
        </w:rPr>
      </w:pPr>
    </w:p>
    <w:p w14:paraId="29DB6309" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:r>
        <w:t xml:space="preserve">After you have the tracking URL, you may send it to your Baidu customer service or your agency, it will take a couple days for Baidu&#x2019;s censorship. After this is done, you can use your tracking tool to sync the account again. </w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="6073082B" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4"/>
    <w:p w14:paraId="380D376F" w14:textId="6FDE3ED5" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:r>
        <w:t>Another situation is you don&#x2019;t want to use the registered domain anymore. Shall I cancel the account and register a new one? The answer is no. Baidu does allow the domain change with one account. The precondition is the new domain you are about to get changed should also belongs to the entity you registered your Baidu account with.</w:t>
      </w:r>
      
      
    </w:p>
    <w:p w14:paraId="6E1460AF" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4"/>
    <w:p w14:paraId="1ECDFEBB" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:r>
        <w:t>The process will be you request a domain change from your Baidu customer service or your agency. Get the new domain ready. Most importantly, you will need to have your entity information on the about us page or something like contact us page. Baidu will check your site to see if it true belong to your registered entity.</w:t>
      </w:r>
    </w:p>
    <w:p w14:paraId="5FB207CD" w14:textId="77777777" w:rsidR="007930C4" w:rsidRDefault="007930C4" w:rsidP="007930C4"/>
    <w:p w14:paraId="3738CD28" w14:textId="286AD3E3" w:rsidR="00657574" w:rsidRDefault="007930C4" w:rsidP="007930C4">
      <w:r>
        <w:t>The third option will be registering a new account. Baidu does allow multiple accounts from same entity for some of the industries. Please check with your Baidu customer or your agency before preceding this option. If you are eligible to create multiple accounts, you will need to go through the account creation process again. Baidu will verify you&#x2019;re documents as well as your new domain. This usually takes 1 - 2 weeks. After this, you can promote using your new domain. The advantage will be you can promote your domains at the same time. The disadvantage will be you have to check your Baidu data separately.</w:t>
      </w:r>
      
      
      
      
      
      
    </w:p>
